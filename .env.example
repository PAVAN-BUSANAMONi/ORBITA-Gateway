# ==============================================================================
# ORBITA-Gateway Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your values.
# Real credentials must never be committed to git.
# ==============================================================================

# Server Binding
# ------------------------------------------------------------------------------
# PORT: Local TCP port for the gateway (default: 3000)
PORT=3000

# HOST: Local bind address (default: 127.0.0.1). Keep localhost for security.
HOST=127.0.0.1

# Local Authentication
# ------------------------------------------------------------------------------
# ROUTER_TOKEN: Secret token used by Claude Code to authenticate with ORBITA-Gateway.
# Set this to a secure random string and configure it in Claude Code as ANTHROPIC_AUTH_TOKEN.
ROUTER_TOKEN=change-this-local-password

# Upstream OpenRouter Configuration
# ------------------------------------------------------------------------------
# OPENROUTER_BASE_URL: OpenRouter API root endpoint (default: https://openrouter.ai/api)
OPENROUTER_BASE_URL=https://openrouter.ai/api

# OPENROUTER_MODEL: Target primary model identifier
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Upstream Credentials Pool (OPENROUTER_KEY_1 through OPENROUTER_KEY_20)
# ------------------------------------------------------------------------------
# Add your OpenRouter API keys below. Empty or undefined variables are ignored.
# At least one key is needed for proxy requests.
OPENROUTER_KEY_1=
OPENROUTER_KEY_2=
OPENROUTER_KEY_3=
# OPENROUTER_KEY_4=
# OPENROUTER_KEY_5=
# ... up to OPENROUTER_KEY_20

# Reliability & Cooldown Tuning
# ------------------------------------------------------------------------------
# KEY_COOLDOWN_MS: Duration in ms a failed credential remains in cooldown (default: 30000)
KEY_COOLDOWN_MS=30000

# REQUEST_TIMEOUT_MS: Maximum upstream request duration in ms before 504 timeout (default: 120000)
REQUEST_TIMEOUT_MS=120000
